<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProjectChicago.Identity.Core\ProjectChicago.Identity.Core.csproj" />
    <ProjectReference Include="..\ProjectChicago.ServiceDefaults\ProjectChicago.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire SQL Server EF Core client integration: wires IdentityDbContext to the Aspire-injected
         "IdentityDb" connection with resilience, health check, and telemetry defaults (aspire.md/database.md). -->
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- EF Core tooling support for migration generation (database.md). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- JWT bearer token authentication (ADR-0018-superseding: mints access/refresh tokens for BFF design). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- OpenAPI document generation for this host's MVC controllers (API-006, API-007). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Scalar.net provides interactive OpenAPI documentation UI (API-006). -->
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
