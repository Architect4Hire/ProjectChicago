{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/design-system": ["./design-system/src/design-system/index.ts"],
      "@/design-system/*": ["./design-system/src/design-system/*"],
      "@/layout/*": ["./design-system/src/layout/*"],
      "@/context/*": ["./design-system/src/context/*"],
      "@/icons/*": ["./design-system/src/icons/*"],
      "@/icons": ["./design-system/src/icons"],
      "@/components/*": ["./design-system/src/components/*"],
      "@/api/*": ["./src/api/*"],
      "@/api": ["./src/api/index.ts"],
      "@/auth/*": ["./src/auth/*"],
      "@/auth": ["./src/auth/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "design-system/src"]
}
