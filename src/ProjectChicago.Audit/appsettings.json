{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://projectchicago.identity",
    "Audience": "projectchicago.services",
    "RefreshAudience": "projectchicago.identity.refresh",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 14
  }
}
